PROJECT_NAME="TalentPulse AI"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL="sqlite:///./data/talentpulse.db"

# Leave SECRET_KEY empty and a random one is generated into data/.secret_key on first run.
SECRET_KEY=""

# GenAI. Without a key the app still works: answers fall back to excerpts taken from the policy text.
LLM_PROVIDER="gemini"          # gemini | groq | openai
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
LLM_TIMEOUT_SECONDS=20

# Demo helpers. Set DEMO_MODE=false for any real deployment.
DEMO_MODE=true
CORS_ORIGINS="http://localhost:5000,http://127.0.0.1:5000,http://localhost:8000,http://127.0.0.1:8000"
MAX_UPLOAD_MB=8
